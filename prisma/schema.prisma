// Topezia — Phase 1 database schema
// Mirrors spec §3 (topezia-phase1-spec.md). Update the spec first, then this file.
// Target: Supabase Postgres with the pgvector extension enabled.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL") // Supabase: pooled vs direct connection
  extensions = [vector]
}

// ─────────────────────────────────────────────
// §3.3 Taxonomy — seeded once, extended over time.
// The taxonomy IS the SEO page generator (see §7).
// ─────────────────────────────────────────────

model Vertical {
  id          String   @id @default(uuid())
  slug        String   @unique // e.g. "tech-software"
  name        String
  isDeepTier  Boolean  @default(false) // true for the 4-5 launch verticals
  cardLayout  CardLayout @default(KNOWLEDGE_WORK)
  roles       Role[]
  jobs        Job[]
  createdAt   DateTime @default(now())
}

enum CardLayout {
  KNOWLEDGE_WORK   // Layout A: tech, creative
  STRUCTURED_HOURLY // Layout B: healthcare, trucking
}

model Role {
  id          String   @id @default(uuid())
  slug        String   @unique // seo_slug — drives /jobs/{role-slug}
  name        String
  verticalId  String
  vertical    Vertical @relation(fields: [verticalId], references: [id])
  aliases     RoleAlias[]
  jobs        Job[]
  createdAt   DateTime @default(now())
}

// Raw title strings → canonical role. Rules-first resolution (§4.2).
model RoleAlias {
  id       String @id @default(uuid())
  rawText  String @unique
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])
  resolvedBy ResolutionSource @default(RULE)
}

model Skill {
  id       String   @id @default(uuid())
  slug     String   @unique
  name     String
  // Seed/canonical skills are reviewed=true; skills auto-created from LLM
  // extraction start reviewed=false (spec §3.3 "behind a review flag") so
  // unvetted skills can be excluded from SEO pages / gap-skill counts until
  // a human approves them.
  reviewed Boolean  @default(false)
  aliases  SkillAlias[]
  jobSkills JobSkill[]
  profileSkills ProfileSkill[]
}

model SkillAlias {
  id         String @id @default(uuid())
  rawText    String @unique
  skillId    String
  skill      Skill  @relation(fields: [skillId], references: [id])
  resolvedBy ResolutionSource @default(RULE)
}

enum ResolutionSource {
  RULE
  LLM
  MANUAL
}

// ─────────────────────────────────────────────
// §3.1 Canonical job schema
// ─────────────────────────────────────────────

enum JobSource {
  GREENHOUSE
  LEVER
  ASHBY
  WORKABLE
  SMARTRECRUITERS
  ADZUNA
  JOOBLE
  CPC_FEED
  FREELANCER_COM
  JOBPOSTING_SCHEMA
  NATIVE // posted by an employer ON Topezia — same table, same pipeline
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  HOURLY
  TEMP
}

// A posting is either a salaried job or a freelance project (click-out to the
// marketplace to bid). Projects reuse the whole Job pipeline — matching,
// insights, dedup — and `kind` is what the feed filters and badges on.
enum JobKind {
  JOB
  PROJECT
}

enum SalaryPeriod {
  YEAR
  HOUR
  DAY
  PER_MILE
  PROJECT
}

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE_US
  REMOTE_GLOBAL
  // Remote, but scoped somewhere that is neither the US nor everywhere —
  // "Remote - Poland", "Remote (EMEA)". These had nowhere to go before and
  // were stamped REMOTE_US, i.e. shown to US seekers as US-eligible.
  REMOTE_INTL
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  EXEC
  NOT_APPLICABLE
}

enum JobStatus {
  // NATIVE postings only: saved by the employer but not yet published, so it
  // is invisible to seekers, to the matcher and to every SEO surface. Every
  // read path filters on `status: "LIVE"` already, so a DRAFT is excluded
  // everywhere by construction — the employer dashboard is the one place
  // that deliberately asks for it.
  DRAFT
  LIVE
  EXPIRED
  SUSPECTED_DEAD
  DUPLICATE
}

model Job {
  id                 String   @id @default(uuid())
  kind               JobKind  @default(JOB)
  source             JobSource
  sourceUrl          String   // canonical click-out destination
  sourceCompanySlug  String?  // e.g. greenhouse board token
  externalId         String?  // source's own id, for change detection

  titleRaw           String
  titleNormalized    String?
  roleId             String?
  role               Role?    @relation(fields: [roleId], references: [id])
  verticalId         String
  vertical           Vertical @relation(fields: [verticalId], references: [id])

  companyName        String
  companyDomain       String?

  descriptionRaw     String
  descriptionHash    String   // sha256 — dedup + cache key, never re-LLM identical text

  skills             JobSkill[]
  seniority          Seniority @default(NOT_APPLICABLE)
  employmentType     EmploymentType
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String   @default("USD")
  salaryPeriod       SalaryPeriod?

  locationRaw        String?
  locationLat        Float?
  locationLng        Float?
  locationState      String?  // drives SEO state pages; US-only concept
  country            String?  // ISO-3166 alpha-2. null = genuinely unknown, never assume US
  remoteScope        String?  // for remote jobs: "GLOBAL" | region ("EMEA") | ISO-2. null = unstated
  remoteType         RemoteType

  // §3.2 vertical-specific fields — healthcare credentials, CDL class, etc.
  verticalFields     Json?

  // pgvector — title + skills + condensed description.
  // Prisma doesn't natively type `vector`; raw SQL migration adds the column,
  // see prisma/migrations/xxxx_add_embeddings/migration.sql
  // embedding        Unsupported("vector(1536)")?

  postedAt           DateTime?
  firstSeenAt         DateTime @default(now())
  lastVerifiedAt      DateTime @default(now()) // drives the freshness stamp on cards

  status             JobStatus @default(LIVE)
  duplicateOfId      String?
  duplicateOf        Job?     @relation("JobDuplicates", fields: [duplicateOfId], references: [id])
  duplicates         Job[]    @relation("JobDuplicates")

  cpcFeedId          String?  // revenue attribution

  // NATIVE postings only: who posted it (always), and the optional company
  // branding — individuals post under their own name.
  postedByUserId     String?
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applications       Application[]

  clicks             JobClick[]
  views              JobView[]
  matchScores        MatchScore[]
  tailoredResumes    TailoredResumeDoc[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // One row per posting, keyed on the source's OWN stable id. The old dedup
  // keyed on a hash of the normalized description, which made "have we seen
  // this?" depend on our extraction code — changing normalization made every
  // job look new and duplicated the feed. Identity can't drift that way.
  @@unique([source, sourceCompanySlug, externalId])
  @@index([status, country])
  @@index([status, verticalId])
  @@index([descriptionHash])
  @@index([locationState])
  @@index([roleId])
  @@index([companyId])
  @@index([postedByUserId])
}

model JobSkill {
  jobId      String
  job        Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill  @relation(fields: [skillId], references: [id])
  isRequired Boolean @default(true) // required vs nice-to-have — feeds honest gap scoring

  @@id([jobId, skillId])
}

// Ingestion source registry — includes founding-employer careers-page URLs (§4.1, §8)
model Source {
  id             String   @id @default(uuid())
  type           JobSource
  companySlug    String?
  companyName    String?  // display name; ATS APIs often don't return it (§4)
  careersPageUrl String?
  isPriority     Boolean  @default(false) // founding-employer flag
  crawlCadenceHrs Int     @default(24)
  lastCrawledAt  DateTime?
  createdAt      DateTime @default(now())

  waitlistSignup WaitlistSignup?

  @@unique([type, companySlug])
}

// ─────────────────────────────────────────────
// Founding-employer waitlist (spec §8) — feeds the admin CMS view
// and doubles as an ingestion source once careers pages are indexed.
// ─────────────────────────────────────────────

enum HiringVolume {
  ONE_TO_FIVE
  SIX_TO_TWENTY
  TWENTY_PLUS
}

enum WaitlistStatus {
  PENDING    // submitted, not yet indexed
  INDEXED    // careers page pulled into Source table
  ACTIVATED  // founding-employer status confirmed at launch
}

model WaitlistSignup {
  id             String   @id @default(uuid())
  companyName    String
  contactName    String
  email          String
  phone          String?
  careersPageUrl String
  hiringVolume   HiringVolume?
  verticalSlug   String?  // matches Vertical.slug, "other" allowed as free text fallback
  status         WaitlistStatus @default(PENDING)

  // set once this submission is enforced against the "first 100" cap (§8)
  isFoundingMember Boolean @default(false)
  foundingRank     Int?    // sequential rank at signup time, null if cap already hit

  // link to the ingestion source once indexed — keeps the CMS and the
  // pipeline pointing at the same record instead of duplicating data
  sourceId       String?  @unique
  source         Source?  @relation(fields: [sourceId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([verticalSlug])
}

// ─────────────────────────────────────────────
// §3.4 User profile schema
// ─────────────────────────────────────────────

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique // Supabase auth user id

  resumeFileUrl    String?  // stays null: résumés are parsed in memory, not stored
  resumeText       String?
  // Profile photo. Best-effort extracted from the uploaded CV (DOCX/PDF) as a
  // small thumbnail data URI — NOT the résumé file itself, which we still never
  // store. Null when the CV had no usable photo. User-editable later.
  photoUrl         String?
  // SEO-friendly slug for the public profile at /p/{publicSlug}
  // (e.g. "raheel-ali-k3m9x2"). Stable once set.
  publicSlug       String?  @unique

  // Public links the member chooses to show on their profile (own + /p page).
  // Display-only: never touch matching or the embedding. URLs are normalised
  // and validated http(s)-only on write — see updateProfileFields.
  linkedinUrl      String?
  githubUrl        String?
  websiteUrl       String?
  contactEmail     String?

  fullName         String?
  headlineRoleId   String?
  seniority        Seniority?
  yearsExperience  Float?
  currentLocation  String?  // where they are today, parsed from the résumé —
                            // distinct from `locations` (where they'd WORK)
  industries       String[] // e.g. ["healthcare", "b2b saas"] — trajectory signal
  workHistory      Json?    // structured, LLM-parsed
  education        Json?
  certifications   String[]
  // Languages the member works in: [{ name, level }]. Level is free text
  // ("Native", "Fluent", "Conversational") — a dropdown taxonomy adds nothing.
  languages        Json?
  // Recommendations the member chooses to show: [{ text, author, role }].
  // Member-entered and member-owned — there is no request/endorse graph yet,
  // and pretending these are third-party attestations would be dishonest;
  // the UI labels them as quotes the member added.
  recommendations  Json?

  skills           ProfileSkill[]
  resumeDoc        ResumeDoc?
  assistWindows    ResumeAssistWindow[]

  // preferences (§3.4)
  employmentTypes  EmploymentType[]
  remoteTypes      RemoteType[]
  locations        String[] // places they'd actually work
  salaryFloor      Int?     // walk-away minimum — the hard filter (§5)
  salaryTarget     Int?     // what they're actually aiming for; scoring signal only,
                            // never a filter (nobody should lose a match for ambition)
  salaryPeriod     SalaryPeriod?
  // Visa reality. Captured and fed to the reranker so why-lines can flag likely
  // sponsorship problems — NOT a hard filter, because we don't extract
  // sponsorship terms from postings, and silently hiding jobs on a guess would
  // be worse than saying nothing.
  workAuthorization WorkAuthorization @default(NOT_SPECIFIED)
  country          String?  // ISO-2, derived from currentLocation — where they ARE
  // Where they may legally work WITHOUT sponsorship (ISO-2). Plural because
  // work rights are: dual nationals, EU citizens, Gulf residents. This — not
  // `country` — is what scopes the feed. Empty = never asked; the matcher then
  // falls back to `country`, preserving the old location-only behaviour.
  authorizedCountries String[]
  // Where they'd MOVE for the right job but would need sponsorship (ISO-2).
  // Jobs here are shown but honestly labelled, and postings whose text
  // explicitly refuses sponsorship are filtered out — see lib/matching/eligibility.ts.
  relocateCountries   String[]
  // Skip the country picker entirely: needs sponsorship ANYWHERE they aren't
  // already authorized. Mutually exclusive with relocateCountries in practice
  // (writing this true clears that list) — see lib/matching/eligibility.ts.
  relocateAnywhere Boolean @default(false)
  verticalsOptIn   String[] // vertical slugs
  tier             MemberTier @default(FREE) // paywall stub — see MemberTier
  // Stripe billing: one customer per profile, created on first checkout.
  // premiumUntil mirrors the subscription's paid-through date (webhook-set) —
  // the honest expiry behind tier=PREMIUM.
  stripeCustomerId String?   @unique
  premiumUntil     DateTime?

  // alternate entry path (trucking questionnaire, §3.4) — same shape, resumeFileUrl null
  entryPath        EntryPath @default(RESUME)

  // Bumped on every profile save; MatchScore rows carry the version they were
  // computed under, so a profile edit transparently invalidates the cache (§5).
  matchVersion     String?

  // Prisma doesn't natively type `vector`; added via raw migration
  // embedding      Unsupported("vector(1024)")?

  clicks           JobClick[]
  saves            JobSave[]
  dismissals       JobDismissal[]
  matchScores      MatchScore[]
  tailoredResumes  TailoredResumeDoc[]

  // Public-profile section visibility: keys the member chose to HIDE from
  // /p/{slug} ("experience", "skills", …). Empty = everything shows.
  hiddenSections    String[] @default([])
  // Master switch for the whole public page: false = /p/{slug} 404s. Sits
  // above hiddenSections, which stay untouched for when it flips back on.
  publicVisible     Boolean  @default(true)
  // Member-chosen availability badge on the public profile.
  openToWork        Boolean  @default(false)

  // /hq override: index this profile even though the spam scorer flagged it.
  // Exists because the scorer has KNOWN false positives — an iGaming marketer
  // or a pharmacologist describes real work in vocabulary that scores badly
  // (see lib/ugc.ts). Without a way to say "no, this person is fine", the only
  // remedy for a wrongly-withheld page would be weakening the scorer for
  // everyone. Never set by the member; only from /hq/spam.
  spamCleared       Boolean  @default(false)

  // Insight alerts (opt-in from /coach): weekly snapshot + diff of the user's
  // market; an email goes out only when something actually moved.
  insightAlerts     Boolean @default(false)
  insightUnsubToken String  @unique @default(uuid()) // one-click unsubscribe, no login needed
  insightSnapshots  InsightSnapshot[]

  portfolios        Portfolio[]
  portfolioSaves    PortfolioSave[]
  portfolioLikes    PortfolioLike[]
  endorsements      Endorsement[]
  publications      Publication[]
  applications      Application[]
  // Companies this person was invited onto and accepted (migration 045).
  companyTeams      CompanyTeamMember[]
  companyWorkSaves  CompanyWorkSave[]
  companyWorkLikes  CompanyWorkLike[]
  companyInquiries  CompanyInquiry[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Cached stage-2 rerank output (spec §5: "cached per profile-version × job").
// One row per (profile, job); re-rank overwrites it and stamps the current
// matchVersion. A cache hit = row exists with matchVersion == profile.matchVersion.
model MatchScore {
  id            String   @id @default(uuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchVersion  String
  score         Int
  matchedSkills String[]
  gapSkills     String[]
  whyLine       String
  createdAt     DateTime @default(now())

  @@unique([profileId, jobId])
  @@index([profileId, matchVersion])
}

enum EntryPath {
  RESUME
  QUESTIONNAIRE
}

// CORE = what the person's roles were hired to do (their professional
// identity); SECONDARY = real adjacent capabilities ("I also build websites").
// Matching, embeddings and stats lead with CORE.
enum SkillTier {
  CORE
  SECONDARY
}

model ProfileSkill {
  profileId  String
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill   @relation(fields: [skillId], references: [id])
  // confidence ≠ proficiency, and conflating them is a bug waiting to happen:
  // confidence = "did the résumé actually say this?" (drives the dashed
  // "confirm?" chip); proficiency = "how good are they?" (feeds match scoring).
  confidence Float   @default(1.0) // 0–1
  proficiency SkillProficiency? // inferred from years/seniority/depth of use
  source     SkillSource @default(RESUME)
  tier       SkillTier @default(CORE)

  @@id([profileId, skillId])
}

/// The Resume Builder document — one per profile (versions come later).
/// The profile stores FACTS (roles, skills, dates, and each role's bullets —
/// see Profile.workHistory); this stores what's additionally WRITTEN on top:
/// a professional summary, plus layout/template choices. Content is one JSON
/// doc — the shape is enforced in lib/resume/doc.ts, not the schema, so
/// iterating on sections never needs a migration. This is always the one
/// MAIN resume; see TailoredResumeDoc for per-job versions.
model ResumeDoc {
  id        String   @id @default(uuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A resume version AI-tailored to one specific job posting — skills
/// reordered/selected, bullets re-emphasized, summary adjusted for that
/// posting. Deliberately a separate table from ResumeDoc rather than a
/// nullable jobId there: Postgres treats NULL as distinct in a unique index,
/// so "one main resume per profile" wouldn't actually be enforced without a
/// hand-written partial index Prisma can't express. jobId is never null here,
/// so @@unique([profileId, jobId]) works exactly as intended — same shape as
/// MatchScore above. Same content shape as ResumeDoc (lib/resume/doc.ts).
model TailoredResumeDoc {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, jobId])
}

/// One row = one "AI resume update": a 24h window of unlimited assist calls,
/// opened by the first drafting click. The QUOTA counts these rows — free
/// tier gets 1 per rolling 30 days, premium 3 per rolling 7 (enforced in
/// lib/resume/assist-quota.ts, which is the only writer). Hand-editing and
/// PDF download are never metered; only the model calls are.
model ResumeAssistWindow {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())

  @@index([profileId, startedAt])
}

enum SkillSource {
  RESUME
  CONFIRMED
  USER_ADDED
}

enum SkillProficiency {
  FAMILIAR // mentioned//exposure
  PROFICIENT // used regularly
  ADVANCED // deep, sustained use
  EXPERT // leads/teaches others in it
}

enum MemberTier {
  FREE
  PREMIUM // reserved: gates the deep roadmap + tracking. Everything is FREE now;
          // this exists so flipping the paywall later is a config change, not a migration.
}

enum WorkAuthorization {
  US_AUTHORIZED // citizen / permanent resident — never needs sponsorship
  AUTHORIZED_NEEDS_FUTURE_SPONSORSHIP // e.g. F-1 OPT: can work now, needs it later
  NEEDS_SPONSORSHIP // needs sponsorship to start
  NOT_SPECIFIED
}

// ─────────────────────────────────────────────
// Signals — ranking fuel (§3.4, §5) and the /go/ redirect log (§6.3)
// ─────────────────────────────────────────────

// A compact weekly capture of a profile's insights, used to diff "what moved"
// between runs — the raw material for insight alerts and the coach page's
// "since last week" card. Payload shape: lib/alerts/insights.ts.
model InsightSnapshot {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now())
  payload    Json

  @@index([profileId, capturedAt])
}

model JobClick {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id])
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  matchScore Int?     // score shown at time of click
  feedPosition Int?   // position in feed at time of click
  cpcAttributed Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([jobId])
  @@index([profileId])
}

/// One person seeing one posting on one day — what the employer dashboard's
/// "views" number counts. Distinct from JobClick, which is a click-OUT to the
/// employer's site and only exists for signed-in feed users.
///
/// Deliberately date-bucketed and deduped: a refresh-spamming visitor (or the
/// employer reloading their own posting) must not be able to inflate the
/// number an employer is shown. `viewerKey` is the signed-in profile id when
/// there is one, else the anonymous topezia_uid cookie — never an IP address,
/// which we don't want to store at all.
model JobView {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  viewerKey String
  profileId String? // known viewer, for later per-audience breakdowns
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([jobId, viewerKey, day])
  @@index([jobId, day])
}

model JobSave {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  jobId     String
  createdAt DateTime @default(now())

  @@unique([profileId, jobId])
}

model JobDismissal {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  jobId     String
  reason    String?  // optional freeform, feeds nightly soft-filter job (§5)
  createdAt DateTime @default(now())

  @@unique([profileId, jobId])
}

// ─────────────────────────────────────────────
// Email alerts (spec §7 capture, §9 delivery) — a saved search per email.
// Captured from SEO pages ("new Account Executive jobs in California"),
// delivered by scripts/send-alerts.ts via Resend.
// ─────────────────────────────────────────────

enum AlertFrequency {
  DAILY
  WEEKLY
}

// Cached LLM-written intro copy for a programmatic SEO page (spec §7:
// "2-3 sentence intro, LLM-written once per page, cached, regenerated
// monthly"). Cached because thousands of pages sharing one templated
// paragraph reads as boilerplate — the whole point is that each page says
// something true and specific about ITS slice of the index. Generated out of
// band by scripts/generate-page-intros.ts; pages never block on the model.
/// Per-page aggregate stats for programmatic SEO pages and market-signal feed
/// cards (SEO addendum §2, market-signals spec §2). Precomputed at the end of
/// each ingestion run — never aggregated at request time.
///
/// Keyed by `pageKey` (the canonical path) rather than a composite of
/// role/vertical/state/country, for the same reason SeoPageIntro is: Postgres
/// treats NULLs as distinct in a unique index, so a composite key with nullable
/// scope columns silently permits duplicate rows and breaks upsert. One text key
/// that already exists as a concept sidesteps that entirely.
model PageStats {
  id           String   @id @default(uuid())
  pageKey      String   @unique // canonical path, e.g. "/jobs/backend-engineer/ca"
  /// "role" | "vertical" | "remote-role" | "role-state" | "role-country"
  scopeType    String

  listingCount Int
  /// Distinct employers in scope — the market-signals `employer_breadth` level.
  companyCount Int

  /// Pay is the midpoint of each posting's range, over postings that actually
  /// state one. Stats describe the DOMINANT pay type in scope (recorded in
  /// payType) rather than mixing hourly and annual into one meaningless median.
  /// A scope with 10+ of both is vanishingly rare at current volume (whole-DB
  /// split is YEAR 2,097 / HOUR 53); when that changes, add a second row keyed
  /// by payType rather than averaging across types.
  payType      String? // "HOUR" | "YEAR"
  medianPay    Int?
  p25Pay       Int?
  p75Pay       Int?
  /// How many postings carried pay. Below 10 the pay block is omitted entirely
  /// rather than shown as "N/A" (addendum §2.1).
  paySampleSize Int     @default(0)

  /// [{ name, n }] — top 5 by frequency across the scope.
  topSkills    Json
  /// { FULL_TIME: pct, CONTRACT: pct, ... } — percentages, rounded.
  empTypeBreakdown Json
  /// Percent of postings in scope that are remote, 0-100.
  remoteShare  Int
  /// Freshness input for the "Updated <date>" line.
  postedLast7d Int

  computedAt   DateTime @default(now())

  @@index([scopeType])
  @@index([computedAt])
}

model SeoPageIntro {
  id          String   @id @default(uuid())
  pageKey     String   @unique // canonical path, e.g. "/jobs/account-executive/ca"
  intro       String
  jobCount    Int // count when written — copy cites it, so staleness is visible
  model       String // which model wrote it, for future re-runs
  generatedAt DateTime @default(now())

  @@index([generatedAt])
}

model JobAlert {
  id             String   @id @default(uuid())
  email          String
  // Deterministic key for the saved search; (email, queryKey) is the dedup key.
  // A string rather than a composite of nullable columns, because in Postgres
  // NULLs aren't equal — a composite unique over them wouldn't dedup at all.
  queryKey       String
  label          String   // human-readable, used in the subject line
  roleId         String?
  verticalId     String?
  locationState  String?
  country        String?  // ISO-2, for /jobs/{role}/{country} alerts
  remoteOnly     Boolean  @default(false)
  frequency      AlertFrequency @default(DAILY)
  lastSentAt     DateTime?
  // Double opt-in: nothing is ever sent to an address that hasn't clicked the
  // confirmation link. Protects deliverability (typos and spam-trap addresses
  // bounce → reputation damage) and is the honest consent bar for bulk email.
  confirmedAt    DateTime?
  confirmToken   String   @unique
  unsubscribedAt DateTime?
  unsubToken     String   @unique
  createdAt      DateTime @default(now())

  @@unique([email, queryKey])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Portfolio — a member's own published work.
//
// NOT to be confused with Job.kind = PROJECT, which is a freelance brief someone
// is hiring for. These are the opposite direction: work already done, shown off.
// The naming overlap is a real trap, so the model, routes (/portfolio) and UI
// copy all say "portfolio" and never "project".
//
// Public by product decision: a portfolio exists to be seen, shared with a
// client who has no account, and indexed. Only creating and saving need auth.
// ─────────────────────────────────────────────────────────────────────────────

enum PortfolioCategory {
  // Marketing & Creative
  BRANDING_IDENTITY
  GRAPHIC_DESIGN
  ILLUSTRATION
  PHOTOGRAPHY
  VIDEO_MOTION
  UI_UX_DESIGN
  SOCIAL_CONTENT
  COPYWRITING
  // Tech & Software
  WEB_APPLICATION
  MOBILE_APP
  API_BACKEND
  OPEN_SOURCE
  DATA_ML
  DEVOPS_INFRA
  TECHNICAL_WRITING
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
}

enum PortfolioMediaKind {
  IMAGE
  VIDEO
}

/// Where an embedded video is hosted. Uploads to our own Vimeo account will
/// reuse VIMEO — the id shape is the same, only who owns the account changes.
enum VideoProvider {
  YOUTUBE
  VIMEO
}

model Portfolio {
  id          String            @id @default(uuid())
  profileId   String
  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Stable public URL, e.g. "monolab-branding-k3m9x2". Never reused.
  slug        String            @unique
  title       String
  description String?
  category    PortfolioCategory
  status      PortfolioStatus   @default(DRAFT)

  // Cover image for the grid. A storage path, resolved to a CDN URL on read.
  coverPath   String?
  // Cover's intrinsic size, so the masonry grid can reserve the right box
  // BEFORE the image loads — without this a Pinterest layout reflows on every
  // image that arrives.
  coverWidth  Int?
  coverHeight Int?

  // Free-text tags, deliberately not FKs to the Skill taxonomy yet: "Technology
  // Used" (Next.js, Figma) largely isn't in a taxonomy built for job skills, and
  // forcing resolution would drop what people actually type. Both are indexed
  // for chip filtering; wiring skills into the taxonomy for matching is a
  // follow-up, once we can see what people really enter.
  skills       String[]
  technologies String[]

  media        PortfolioMedia[]
  saves        PortfolioSave[]
  likes        PortfolioLike[]
  endorsements Endorsement[]

  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([profileId, status])
  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
}

model PortfolioMedia {
  id          String             @id @default(uuid())
  portfolioId String
  portfolio   Portfolio          @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  kind        PortfolioMediaKind

  // IMAGE: storage object path. VIDEO: the extracted id (same as videoId).
  // Never a user-supplied filename — see the upload route.
  path        String
  // VIDEO only: provider + extracted id, so embeds are built by us rather than
  // by interpolating a user-supplied URL into an iframe src.
  videoId     String?
  videoProvider VideoProvider?
  // VIDEO only: Vimeo's unlisted-video hash, which the embed needs to play.
  // Always null for YouTube.
  videoHash   String?

  width       Int?
  height      Int?
  caption     String?
  position    Int                @default(0)

  createdAt   DateTime @default(now())

  @@index([portfolioId, position])
}

model PortfolioSave {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([profileId, portfolioId])
  @@index([profileId, createdAt])
}

// A public "like" on a piece of work — the counterpart to PortfolioSave,
// which is a private bookmark.
//
// The count is shown on the work's own page and nowhere else: it never
// orders the grid, never feeds matching, and never appears on a profile.
// That is the line that keeps it a signal of appreciation rather than a
// ranking, which is what would push people to post what performs instead of
// what represents them.
model PortfolioLike {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  // One like per person per piece — enforced here, not in application code,
  // so a double-click or a retried request can never inflate a count.
  @@unique([profileId, portfolioId])
  @@index([portfolioId, createdAt])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// A first-party blog post ("Topezia Team" byline, no per-user authorship —
// /hq's admin gate is a single shared password, not per-account). Free-text
// admin-chosen tags, not a taxonomy — same reasoning as Portfolio.skills.
model Post {
  id              String     @id @default(uuid())
  slug            String     @unique
  title           String
  excerpt         String?
  contentHtml     String
  coverImage      String?
  coverImageAlt   String?

  // SEO fields — all optional, all with fallbacks at render time
  // (metaTitle -> title, metaDescription -> excerpt).
  focusKeyword    String?
  metaTitle       String?
  metaDescription String?

  tags            String[]
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // GIN index on `tags` is added by hand in the migration SQL — not expressed
  // here, same as this schema already does for non-btree index types.
  @@index([status, publishedAt])
}

// A recommendation or review someone ELSE wrote about a member.
//
// The distinction from Profile.recommendations (a JSON blob the member types
// themselves) is the whole point: these arrive through an invite link that
// the member sends out but cannot write into. The member may hide one, never
// edit it — see lib/endorsements/doc.ts for why hiding has to stay allowed.
//
// A RECOMMENDATION is about the person. A REVIEW is about one piece of work,
// so it hangs off a Portfolio row and may carry a rating.
//
// Two shapes share this table:
//  - An INVITE: status PENDING, holds the shareable token. Standing — it
//    lives until the member deletes it (that deletion is the kill switch
//    that used to be the expiry date).
//  - A RESPONSE: status SUBMITTED, points at its invite via inviteId. Each
//    signed-in author gets at most one response per invite (unique below),
//    so a shared link can collect many voices but one account can't stack.
model Endorsement {
  id          String            @id @default(uuid())
  profileId   String            // who it is about
  profile     Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  kind        EndorsementKind
  status      EndorsementStatus @default(PENDING)

  // The secret in the invite URL (/r/{token}). High entropy, single use:
  // once submitted it can only be read back, never written again.
  token       String            @unique
  // Who the member says they sent it to — their own note-to-self, shown only
  // to them. We never email anyone, so this is a label, not an address.
  sentToLabel String?
  // Optional personal line from the member, shown on the write page.
  requestNote String?
  // REVIEW only: the piece of work being reviewed.
  portfolioId String?
  portfolio   Portfolio?        @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  // RESPONSE only: the standing invite it answered. SetNull so revoking an
  // invite kills the link but never takes the words people already wrote.
  inviteId    String?
  invite      Endorsement?      @relation("InviteResponses", fields: [inviteId], references: [id], onDelete: SetNull)
  responses   Endorsement[]     @relation("InviteResponses")

  // Filled in by the AUTHOR through the public form; null while PENDING.
  // The author must be signed in — their Supabase user id, which is what
  // makes "someone else wrote this" enforceable rather than merely claimed.
  authorUserId String?
  authorName  String?
  authorRole  String?
  text        String?
  rating      Int?              // REVIEW only, 1-5
  submittedAt DateTime?

  // The member's display choice. Hiding is allowed (an unverified link could
  // otherwise be used to plant something damaging); editing never is.
  visible     Boolean           @default(true)

  createdAt   DateTime          @default(now())
  // Kept for the historical single-use rows; standing invites carry a
  // far-future sentinel. Revocation (deleting the invite) is the control now
  // that authors must sign in — see lib/endorsements/doc.ts.
  expiresAt   DateTime

  // One response per author account per invite — the DB is the lock, so two
  // tabs (or a retry) can't double-post. NULLs (invites, legacy rows) are
  // distinct in Postgres and never collide.
  @@unique([inviteId, authorUserId])
  @@index([profileId, status])
}

// Published written work — the ResearchGate-shaped section: papers, books,
// theses. Member-entered and member-owned, like education; we verify nothing
// (a DOI link is checkable by the reader, which is exactly why we show it).
model Publication {
  id        String          @id @default(uuid())
  profileId String
  profile   Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type      PublicationType
  title     String
  // Authors as printed on the work, in order — includes the member and any
  // co-authors. Free text: author lists don't resolve to accounts.
  authors   String[]
  // Journal, conference, or publisher — whichever the type calls for.
  venue     String?
  year      Int?
  // Reader-checkable identifiers. DOI for papers, ISBN for books.
  doi       String?
  isbn      String?
  url       String?
  abstract  String?
  // Cover thumbnail — the storage PATH ("{profileId}/{uuid}.jpg"), never a full
  // URL, so moving bucket or CDN stays a change to lib/publications/storage.ts
  // rather than a data migration. Same contract as Portfolio.coverPath.
  imagePath String?

  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([profileId, position])
}

enum PublicationType {
  JOURNAL_ARTICLE
  CONFERENCE_PAPER
  BOOK
  BOOK_CHAPTER
  THESIS
  REPORT
  PREPRINT
  OTHER
}

enum EndorsementKind {
  RECOMMENDATION // about the person
  REVIEW         // about one piece of work
}

enum EndorsementStatus {
  PENDING
  SUBMITTED
}

// ─────────────────────────────────────────────
// Employer side — companies, native postings, applications
// ─────────────────────────────────────────────

// The employer identity behind a NATIVE posting. One per account for now.
model Company {
  id          String  @id @default(uuid())
  ownerUserId String  @unique
  name        String
  slug        String  @unique // public page at /company/{slug}

  // Billing lives on the COMPANY, not the owner: an owner handover must not
  // cancel the plan. "FREE" | "PRO" | "STUDIO" — TEXT so a new tier is a code
  // change, not a type migration. The Stripe webhook is the only writer of
  // plan/planUntil, same rule as Profile.tier. See lib/billing/plans.ts.
  plan             String    @default("FREE")
  planUntil        DateTime?
  stripeCustomerId String?   @unique
  // Pooled monthly AI allowance for multi-site plans (see lib/widget/caps.ts).
  aiMonthKey       String    @default("")
  aiRepliesUsed    Int       @default(0)
  // Paying, but keeping the "AI chat powered by Topezia" badge for a
  // standing discount. Orthogonal to plan — it survives a plan change, and
  // while true the widget ALWAYS shows the badge (migration 059).
  brandingDiscount Boolean   @default(false)
  tagline     String?
  about       String?
  website     String?
  location    String?
  /// Storage PATH inside the `logos` bucket ("{companyId}/{uuid}.png"), never a
  /// full URL — same contract as Portfolio.coverPath. lib/company/storage.ts
  /// turns it into a URL, so moving bucket or CDN is one function, not a data
  /// migration. Was `logoUrl` until migration 041; it was never written.
  logoPath    String?

  jobs        Job[]

  // Everything below arrived with migration 045 — the company's own presence,
  // as opposed to its postings. All of it is user-generated, so all of it is
  // scored by lib/ugc.ts on write and gated by lib/company/indexing.ts on read.
  work          CompanyWork[]
  testimonials  CompanyTestimonial[]
  testimonialInvites CompanyTestimonialInvite[]
  clients       CompanyClient[]
  articles      CompanyArticle[]
  team          CompanyTeamMember[]
  invites       CompanyInvite[]

  // Contact form (migration 050). The form is the ONLY way a member can start
  // contact with a company — there is deliberately no open "message this
  // company" channel, so a conversation exists only when the company replies
  // to a submission (see CompanyInquiry). Off by default: presence without an
  // inbox is a valid choice.
  contactEnabled   Boolean  @default(false)
  // Company-chosen "reason for contact" options ("Hiring inquiry",
  // "Partnership", …). Empty = the form shows no reason dropdown.
  contactReasons   String[] @default([])
  // Up to 3 extra free-text questions (labels only; answers are snapshotted
  // on the inquiry, so editing these never corrupts old submissions).
  contactQuestions String[] @default([])
  inquiries        CompanyInquiry[]
  // The embeddable site chat widget (migration 051). One per company — the
  // unique IS the free-tier cap.
  widgetSites      WidgetSite[]

  // /hq override for the spam scorer, exactly as Profile.spamCleared: the
  // scorer has known false positives and the only other remedy would be
  // weakening it for everyone. Never set by the employer.
  spamCleared Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// NEW = sitting in the company inbox, nothing has happened. REPLIED = the
// company answered, which is the one and only thing that opens a thread.
// ARCHIVED = the company closed it (or it aged out). SPAM = the company's
// judgement of the sender — it feeds the platform-wide throttle below and is
// never shown to the sender (they just see "Sent").
enum InquiryStatus {
  NEW
  REPLIED
  ARCHIVED
  SPAM
}

enum InquirySender {
  COMPANY
  CANDIDATE
}

// Where an inquiry came from. FORM = the contact form on /company/{slug},
// sender is a signed-in member (profileId set). WIDGET = the chat widget on
// the company's own website, sender is an anonymous visitor identified only
// by the email they left (visitorEmail/threadToken set, profileId null).
enum InquirySource {
  FORM
  WIDGET
}

// One company's installed chat widget (migration 051).
model WidgetSite {
  id           String   @id @default(uuid())
  /// NOT unique since migration 062 — a company may run the chat on several
  /// websites. The allowance is enforced in code from the company's plan, so
  /// changing it never needs a migration.
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  domain       String
  // Public key in the embed snippet. Identifies, never authorizes — every
  // owner action still goes through requireCompanyOwner.
  siteToken    String   @unique
  enabled      Boolean  @default(true)
  // The free tier's "Powered by Topezia · Add AI chat to your site. Free."
  // line under the chat. True until a paid plan turns it off — the switch is
  // real, the plan that flips it isn't built yet (no employer billing).
  branded      Boolean  @default(true)
  pagesCrawled Int      @default(0)
  crawledAt    DateTime?
  crawlError   String?
  /// Detected from the store's own links; the checkout slug is customisable.
  checkoutPath String?
  /// "woocommerce" | "shopify" | null — the two hand off to checkout in
  /// completely different ways, so the link builder must know which.
  storeKind    String?
  // Monthly AI budget as (which month, used) — rolls over by comparison at
  // read time, no cron reset. See lib/widget/caps.ts.
  monthKey     String   @default("")
  messagesUsed Int      @default(0)
  // Weekly "what visitors asked" email. On by default — it only sends when
  // the week had activity; digestSentAt guards double-sends.
  digestEnabled Boolean   @default(true)
  digestSentAt  DateTime?
  // The widget in the customer's colour (hex, validated on write).
  accentColor   String?
  // {"tz","days":[1..7],"start":"09:00","end":"17:00"} — when set, the chat
  // says plainly that nobody's there rather than implying someone is.
  replyHours    Json?
  chunks       SiteChunk[]
  products     SiteProduct[]
  questions    WidgetQuestion[]
  facts        SiteFact[]
  inquiries    CompanyInquiry[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Answers the OWNER wrote — "teach the bot". Retrieved alongside the crawl
// and given priority over it, because a human correcting the assistant
// outranks whatever the page said.
//
// NOT A CACHE. SiteChunk/SiteProduct are wiped on every crawl; this table
// must survive them, or "correct it once" becomes "correct it every scan".
model SiteFact {
  id        String     @id @default(uuid())
  siteId    String
  site      WidgetSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  // vector(1024) of question+answer, written via raw SQL like SiteChunk:
  // embedding Unsupported("vector(1024)")?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())

  @@index([siteId])
}

// Rolling log of what visitors asked the AI — feeds the weekly digest and
// its content-gap advice. Purged past ~90 days by the digest cron.
model WidgetQuestion {
  id        String     @id @default(uuid())
  siteId    String
  site      WidgetSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  question  String
  // false = the bot handed off — the site's content couldn't answer it.
  answered  Boolean    @default(true)
  pageUrl   String?
  createdAt DateTime   @default(now())

  @@index([siteId, createdAt])
}

// A chunk of the customer's own site, embedded for retrieval. Wiped and
// rewritten on every crawl — a cache of their site, not a record.
model SiteChunk {
  id        String     @id @default(uuid())
  siteId    String
  site      WidgetSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  title     String     @default("")
  content   String
  // vector(1024), written via raw SQL like Job/Profile:
  // embedding Unsupported("vector(1024)")?
  createdAt DateTime   @default(now())

  @@index([siteId])
}

// A product harvested from the site's own Product JSON-LD during the crawl
// (migration 052). Products found = the site sells things = the widget may
// answer buy-intent with product cards instead of prose. Same cache
// semantics as SiteChunk: wiped and rewritten every crawl.
/// A product harvested from the site's own markup. externalId/variations/
/// buyable exist so the chat can hand a visitor to the STORE'S OWN checkout
/// with the item in the cart — we never take the payment (migration 060).
model SiteProduct {
  id          String     @id @default(uuid())
  siteId      String
  site        WidgetSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url         String
  name        String
  price       String? // display string ("$99", "From $49") — never arithmetic
  image       String?
  description String     @default("")
  /// The store's own product id, read from the product page's markup.
  externalId  String?
  /// Purchasable options: [{ id, label, price, attributes }]. A "From $150"
  /// page is several real prices; the visitor picks one before checkout.
  variations  Json?
  /// Purchasable AND in stock at crawl time — false hides the buy button
  /// rather than sending someone to a dead checkout.
  buyable     Boolean    @default(false)
  // embedding Unsupported("vector(1024)")? — raw SQL, as everywhere
  createdAt   DateTime   @default(now())

  @@index([siteId])
}

// One member's contact-form submission to one company. This is an inbox ITEM,
// not a conversation: the sender cannot follow up, bump, or re-send while it
// sits unanswered. Only a company reply turns it into a thread
// (InquiryMessage). That asymmetry is the whole anti-spam design — the
// LinkedIn-InMail failure mode is candidate-initiated open messaging.
//
// Spam throttle: a member whose inquiries have been marked SPAM by 3+
// DISTINCT companies is refused new submissions platform-wide. The count is
// computed at submit time from these rows — no separate counter to drift.
model CompanyInquiry {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Null for WIDGET inquiries — an anonymous website visitor has no Profile.
  // FORM inquiries always set it (enforced in the route, not the schema).
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  source    InquirySource @default(FORM)
  // The anonymous sender, when source is WIDGET: the email they left, the
  // name they gave, their key to /i/{threadToken} (possession = the reply
  // email reached that mailbox), and the chat that led here
  // ([{ role: 'visitor'|'bot', text }]).
  visitorEmail String?
  visitorName  String?
  visitorPhone String?
  threadToken  String? @unique
  transcript   Json?
  /// Which website this lead came through (migration 062). Null for contact
  /// -form inquiries and for widget leads predating the column. SET NULL on
  /// site delete — a lead belongs to the company and outlives the site.
  siteId       String?
  site         WidgetSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  // Concierge intake: what the chat established about the job, extracted at
  // submission — { summary, wants, budget, timeline, openQuestions }. Every
  // field is null unless the visitor actually said it.
  brief        Json?

  // Revenue attribution, entirely owner-entered: "WON" | "LOST" | null
  // (null = still open). dealValue is whole currency units the OWNER typed.
  // Nothing here is ever inferred — see migration 057.
  outcome      String?
  dealValue    Int?
  outcomeAt    DateTime?

  // One of Company.contactReasons at submit time; null when the company
  // configured no reasons.
  reason    String?
  message   String
  // Snapshot of [{ question, answer }] for the company's contactQuestions at
  // submit time — the config can change later without corrupting history.
  answers   Json?

  status    InquiryStatus @default(NEW)
  repliedAt DateTime?

  messages  InquiryMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The open-inquiry rule (one NEW inquiry per member per company) is a
  // partial unique index in raw SQL — Prisma can't express WHERE clauses:
  //   CREATE UNIQUE INDEX "CompanyInquiry_open_one_per_sender"
  //     ON "CompanyInquiry"("companyId", "profileId") WHERE status = 'NEW';
  // and for widget visitors, per SITE since migration 062 (a visitor writing
  // to two client sites of one agency is two conversations, not a duplicate):
  //   CREATE UNIQUE INDEX "CompanyInquiry_open_one_per_visitor"
  //     ON "CompanyInquiry"("siteId", "visitorEmail")
  //     WHERE status = 'NEW' AND source = 'WIDGET';
  @@index([companyId, status, createdAt])
  @@index([profileId, createdAt])
  @@index([companyId, outcome])
  @@index([siteId])
}

// A message inside an opened thread. The first row is always the company's
// reply (sender COMPANY) — enforced in code, since the thread only exists
// once the company answers. The original submission text stays on
// CompanyInquiry.message, not here.
model InquiryMessage {
  id        String         @id @default(uuid())
  inquiryId String
  inquiry   CompanyInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender    InquirySender
  body      String
  createdAt DateTime       @default(now())

  @@index([inquiryId, createdAt])
}

// APPLIED → SHORTLISTED → INTERVIEW → SELECTED is the employer's pipeline;
// REJECTED can happen from any stage; WITHDRAWN is the applicant's own exit.
enum ApplicationStage {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

// One member's application/proposal to one NATIVE posting.
model Application {
  id               String           @id @default(uuid())
  jobId            String
  job              Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profileId        String
  profile          Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stage            ApplicationStage @default(APPLIED)
  coverNote        String?
  // Projects carry a bid; jobs leave these null.
  proposedRate     Int?
  proposedCurrency String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([jobId, profileId])
  @@index([profileId])
  @@index([jobId, stage])
}

// What a visitor is pointing at. Every value here must correspond to a page
// that is PUBLIC — a report is a signal about something a stranger can see, so
// there is nothing to report about a draft or a dashboard.
//
// The three COMPANY_* values arrived with migration 047. Company pages carry
// testimonial copy and outbound client links, which is exactly the surface a
// visitor is best placed to notice going wrong; before this they were the only
// public UGC on the site with no way to flag them.
enum ReportKind {
  PROFILE
  PORTFOLIO
  COMPANY
  COMPANY_WORK
  COMPANY_ARTICLE
}

enum ReportReason {
  SPAM
  IMPERSONATION
  OFFENSIVE
  NOT_THEIR_WORK
  OTHER
}

// Someone telling us a public page is wrong.
//
// A report is a SIGNAL, never an action: filing one hides nothing and changes
// no score. It puts the page in the /hq queue for a person to look at. The
// alternative — auto-hiding on N reports — turns the button into a way to take
// someone's profile down, which on a site about people's careers is a worse
// failure than the spam it would catch.
//
// No IP is stored. Rate limiting happens in memory at the route; keeping a log
// of who-looked-at-whom is exactly the sort of data this product has avoided
// elsewhere (résumé files, contact emails on public pages), and it would be
// retained long after it stopped being useful.
model ContentReport {
  id             String       @id @default(uuid())
  kind           ReportKind
  targetId       String // Profile.id or Portfolio.id — deliberately not an FK,
                        // so a report survives the thing it is about being deleted
  reason         ReportReason
  note           String?
  // Supabase auth id when the reporter was signed in; null when they weren't.
  reporterUserId String?

  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolution     String?

  // One report per person per page. NULLs are DISTINCT in Postgres, so this
  // deliberately does NOT collapse anonymous reports into one — those are
  // bounded by the route's rate limit instead.
  @@unique([kind, targetId, reporterUserId])
  @@index([resolvedAt, createdAt])
  @@index([kind, targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Company presence (migration 045) — the work, the proof, the writing, the team
//
// The member side already has all four of these shapes (Portfolio, Endorsement,
// Post, Profile). These are deliberately SEPARATE tables rather than a
// nullable companyId bolted onto those, for two different reasons:
//
//  - Portfolio/Endorsement hang off a Profile with a NOT NULL FK, and every
//    query, save path and delete path in the app assumes that. Making the owner
//    polymorphic would mean auditing all of it, forever, on every future change.
//  - Post is FIRST-PARTY editorial. app/blog, the tag pages, the sitemap and
//    /hq/posts all read it with no author filter, and sanitizeBlogHtml
//    deliberately leaves external links DOFOLLOW because the site chose them.
//    A company article is user-generated content: it must be nofollowed and it
//    must not appear on /blog. One shared table would make that a filter
//    everyone has to remember; two tables make it true by construction.
// ─────────────────────────────────────────────────────────────────────────────

// One piece of work the company did — the agency case study, the shipped
// product. PortfolioStatus is reused rather than cloned: DRAFT/PUBLISHED means
// exactly the same thing here as it does for a member's work.
model CompanyWork {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Stable URL at /company/{companySlug}/work/{slug}. Unique per company, not
  // globally: two agencies may both have done a "brand refresh".
  slug        String
  title       String
  // One line for the card; the body is the case study itself.
  summary     String?
  description String?
  // Who it was for. Free text — a client is rarely an account on Topezia.
  clientName  String?
  // Live link to the work. OUTBOUND and user-supplied: rendered with
  // rel="ugc nofollow" (lib/ugc.ts UGC_REL), like every other UGC link.
  projectUrl  String?
  tags        String[]

  // Cover for the grid, plus its intrinsic size so the card reserves the right
  // box before the image arrives — same reasoning as Portfolio.coverWidth.
  coverPath   String?
  coverWidth  Int?
  coverHeight Int?

  status      PortfolioStatus @default(DRAFT)
  position    Int             @default(0)

  media       CompanyWorkMedia[]
  saves       CompanyWorkSave[]
  likes       CompanyWorkLike[]

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, status, position])
}

// Images and embedded videos on one piece of work. Deliberately the same shape
// as PortfolioMedia, and it reuses PortfolioMediaKind/VideoProvider and the
// whole of lib/portfolio/video.ts rather than growing a second parser: a
// YouTube URL means the same thing whoever pasted it.
//
// Was CompanyWorkImage until migration 046, when videos arrived and the name
// stopped being true. Renamed while the table still held zero rows.
// A private bookmark on a company's work, and a public "like".
//
// Exact mirrors of PortfolioSave and PortfolioLike, including the rule that
// matters most: the like COUNT lives on the work's own page and nowhere else.
// It never orders the company page, never feeds matching, and never appears on
// a profile — the line that keeps it appreciation rather than a leaderboard.
//
// Keyed by Profile, not by auth user: liking needs a real account, and Profile
// is what every other "this member did something" row in this schema points at.
model CompanyWorkSave {
  id        String      @id @default(uuid())
  profileId String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workId    String
  work      CompanyWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([profileId, workId])
  @@index([profileId, createdAt])
}

model CompanyWorkLike {
  id        String      @id @default(uuid())
  profileId String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workId    String
  work      CompanyWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  // One like per person per piece — enforced by the DB, so a double-click or
  // a retried request can never inflate a count.
  @@unique([profileId, workId])
  @@index([workId, createdAt])
}

model CompanyWorkMedia {
  id            String             @id @default(uuid())
  workId        String
  work          CompanyWork        @relation(fields: [workId], references: [id], onDelete: Cascade)

  kind          PortfolioMediaKind @default(IMAGE)

  // IMAGE: storage path inside the `company` bucket, never a full URL.
  // VIDEO: the extracted provider id (same value as videoId).
  path          String
  // VIDEO only: provider + id, so the embed is built by us rather than by
  // interpolating a user-supplied URL into an iframe src.
  videoId       String?
  videoProvider VideoProvider?
  // VIDEO only: Vimeo's unlisted-video hash, which the embed needs to play.
  // Always null for YouTube.
  videoHash     String?

  width         Int?
  height        Int?
  caption       String?
  position      Int                @default(0)

  createdAt     DateTime @default(now())

  @@index([workId, position])
}

// A client quote the COMPANY typed in.
//
// Not an Endorsement: an Endorsement is written by a signed-in third party
// through an invite the subject cannot write into, which is what makes "someone
// else said this" enforceable. Nothing here is verified — a company's clients
// generally have no Topezia account — so the public page labels these as
// supplied by the company and they carry no schema.org Review markup. Calling
// them the same thing as an Endorsement would launder unverified copy through
// a word that means something stricter.
 // Where a testimonial came from. The public page prints this, because the two
 // are not the same claim: COMPANY is copy the company typed about itself,
 // INVITED was written by whoever controlled the email address the company sent
 // the invitation to.
 //
 // INVITED is not "verified" in any strong sense and the UI never says it is —
 // it means one specific thing, and the label says exactly that thing.
enum TestimonialOrigin {
  COMPANY
  INVITED
}

model CompanyTestimonial {
  id            String  @id @default(uuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  origin        TestimonialOrigin @default(COMPANY)
  /// INVITED only: when the client submitted it.
  submittedAt   DateTime?
  invite        CompanyTestimonialInvite?

  quote         String
  authorName    String
  authorRole    String?
  authorCompany String?
  // Optional link to the person or their company — UGC, so nofollowed.
  authorUrl     String?
  rating        Int?    // 1-5, optional

  position      Int     @default(0)
  visible       Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, position])
}

 // An outstanding request for a client to write a testimonial themselves.
 //
 // A SEPARATE table rather than a half-filled CompanyTestimonial: a pending
 // invite has no quote and no author, and making those columns nullable to
 // accommodate it would mean every read path has to cope with a testimonial
 // that isn't one. Same shape as CompanyInvite for the team, for the same
 // reason.
 //
 // The client does NOT need a Topezia account. Requiring one would kill the
 // response rate — a design client has no reason to hold an account here — and
 // it would not buy much: the meaningful check is that they received the email,
 // which the token already proves. What it is NOT is proof of identity, and the
 // public label is worded accordingly.
model CompanyTestimonialInvite {
  id            String              @id @default(uuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email         String
  /// What the company calls them, for their own list. Never shown publicly —
  /// the client types their own name when they answer.
  clientLabel   String?
  /// The secret in /t/{token}. Consumed once on submit.
  token         String              @unique
  status        CompanyInviteStatus @default(PENDING)

  expiresAt     DateTime
  submittedAt   DateTime?
  /// The testimonial it produced, once answered.
  testimonialId String?             @unique
  testimonial   CompanyTestimonial? @relation(fields: [testimonialId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())

  // One outstanding request per address per company. Revoking deletes the row,
  // so this can never strand anyone.
  @@unique([companyId, email])
  @@index([companyId, status])
}

// A client logo with a link to that client's site. The link is the whole point
// of the feature and also its only real risk: it is an outbound, user-supplied
// URL on a page we host, so it renders with rel="ugc nofollow" and the company
// page's own indexability is gated on the spam score of everything on it.
model CompanyClient {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  websiteUrl String?
  // Storage path in the `logos` bucket, under "{companyId}/clients/".
  logoPath   String?
  position   Int     @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, position])
}

// The company's own writing, at /company/{companySlug}/articles/{slug}.
//
// Same editor as /hq/posts and the same SEO fields, but a different table and a
// different sanitizer (sanitizeUgcHtml, not sanitizeBlogHtml) — see the header
// above. Never appears on /blog.
model CompanyArticle {
  id              String     @id @default(uuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  slug            String
  title           String
  excerpt         String?
  contentHtml     String
  // Storage path in the `company` bucket. Named coverPath, not coverImage,
  // to match the path-not-URL contract every other image column here uses.
  coverPath       String?
  coverAlt        String?

  focusKeyword    String?
  metaTitle       String?
  metaDescription String?

  tags            String[]
  status          PostStatus @default(DRAFT)

  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, status, publishedAt])
}

// OWNER is the Company.ownerUserId — the only account that can edit anything.
// MEMBER is listed on the company page and nothing more. That gap is
// deliberate: the ask was "invite team members to join Topezia and be listed
// under the company", and handing every invitee write access to the employer's
// public page and hiring pipeline is a permissions system, not a listing.
enum CompanyRole {
  OWNER
  MEMBER
}

enum CompanyInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model CompanyTeamMember {
  id           String      @id @default(uuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The Supabase auth id is the anchor, not the profile: someone can join a
  // team before they have built a profile, and deleting a profile must not
  // silently remove them from a company they really do work at.
  userId       String
  profileId    String?
  profile      Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)

  // Snapshot taken at accept time, so the row still renders a name after a
  // profile is deleted. The live profile wins when there is one.
  name         String
  title        String?
  role         CompanyRole @default(MEMBER)
  visible      Boolean     @default(true)
  // Which address the invite went to — kept so the owner can tell two people
  // with the same display name apart. Never shown publicly.
  invitedEmail String?

  joinedAt     DateTime    @default(now())

  @@unique([companyId, userId])
  @@index([companyId, role])
}

// A pending invitation to join a company's team.
//
// Revoking DELETES the row rather than flagging it: the token is the capability,
// and the only honest way to withdraw a capability is to destroy it. REVOKED
// exists in the enum for invites that were declined server-side after the fact.
model CompanyInvite {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email           String
  // The secret in /join/{token}. High entropy; consumed once on accept.
  token           String              @unique
  invitedByUserId String
  status          CompanyInviteStatus @default(PENDING)

  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?

  createdAt       DateTime @default(now())

  // One invite per address per company. Re-inviting means revoking first,
  // which deletes the row — so this can't strand anyone.
  @@unique([companyId, email])
  @@index([companyId, status])
}
