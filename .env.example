# Supabase — Project Settings → Database → Connection string
# Use the POOLED connection for DATABASE_URL (app runtime, serverless-safe)
# and the DIRECT connection for DIRECT_URL (migrations only).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"  # workers only — never expose client-side

# LLM — every model call goes through lib/llm.ts (see docs/ai-cost-strategy.md).
# ANTHROPIC_API_KEY is the fallback for every workload. Optionally give each
# bucket its own key so the Anthropic console splits the bill for you:
#   widget    = visitor chat, digest themes, lead brief, inbox draft
#   ingestion = job extraction during ingestion / employer publish
#   member    = rerank, resume parse/assist/tailor, posting assist
#   ops       = one-off scripts (SEO intros, skill canonicalisation)
ANTHROPIC_API_KEY=""
ANTHROPIC_API_KEY_WIDGET=""
ANTHROPIC_API_KEY_INGESTION=""
ANTHROPIC_API_KEY_MEMBER=""
ANTHROPIC_API_KEY_OPS=""
# Kill switch, comma-separated buckets and/or features, e.g. "widget,resume.tailor" or "all".
# Every feature degrades to its no-model path (canned reply, provisional score, 503).
AI_DISABLED=""
# Widget: cosine distance under which an owner-taught answer is served verbatim
# without a model call (lib/widget/shortcut.ts). Default 0.12; tune from logs.
WIDGET_TAUGHT_EXACT_DISTANCE=""
# Widget: cosine distance under which a recent first-turn answer is reused for
# the next visitor (lib/widget/answer-cache.ts). Default 0.08; 24h TTL.
WIDGET_ANSWER_CACHE_DISTANCE=""
# Ingestion: let title/role/skill-dictionary rules extract a posting without the
# model when they all agree (lib/ingestion/rules-extract.ts). Off until the skill
# dictionary is curated — see the eval numbers in the file. "1" to enable.
INGEST_RULES_FIRST=""
# Resume parse: how many pages of a SCANNED PDF the vision parse reads (default 3).
RESUME_SCAN_MAX_PAGES=""

# Embeddings — Voyage AI, Anthropic's recommended embedding partner (spec §5)
VOYAGE_API_KEY=""

# CPC feed integrations (spec §8) — add as each is onboarded
TALENT_COM_API_KEY=""
JOOBLE_API_KEY=""

# Canonical site URL — used for sitemap generation, SEO metadata, and
# building absolute links in alert emails.
NEXT_PUBLIC_SITE_URL="https://topezia.com"

# Admin CMS — /admin/waitlist. Pick any long random string. Visit
# /admin/waitlist?token=THIS_VALUE once to authenticate (sets a cookie).
ADMIN_ACCESS_TOKEN=""

# LinkedIn sign-in. Set to "1" ONLY after the Supabase provider is live:
#  1. LinkedIn Developers → create an app → add product "Sign In with
#     LinkedIn using OpenID Connect" → copy Client ID + Secret.
#  2. Supabase Dashboard → Authentication → Providers → LinkedIn (OIDC) →
#     enable, paste ID + Secret.
#  3. In the LinkedIn app's Auth tab, add the redirect URL Supabase shows
#     there (https://[PROJECT-REF].supabase.co/auth/v1/callback).
# The button on /login only renders when this is "1", so nothing broken
# ships while the provider is unconfigured.
NEXT_PUBLIC_LINKEDIN_AUTH=""

# ── Cloudflare Turnstile (signup captcha) ──────────────────────────────────
# Inert while empty: no script loads, no token is sent, signup behaves exactly
# as it does today. To switch it on, IN THIS ORDER:
#   1. Cloudflare dashboard → Turnstile → add a site → copy the SITE key here
#      and the SECRET key into Supabase (Auth → Settings → Bot & Abuse
#      Protection → Turnstile).
#   2. Deploy, so the widget is live and producing tokens.
#   3. ONLY THEN enable the captcha check in Supabase.
# Doing 3 before 1-2 breaks every signup and sign-in on the site, because
# Supabase would demand a token nothing is producing yet.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
